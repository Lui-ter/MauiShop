<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="petshop.Views.HelpSupportPage"
             xmlns:views="clr-namespace:petshop.Views"
             Title="HelpSupportPage">

    <ContentPage.BindingContext>
        <views:HelpSupportData/>
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*">
        <Label Text="{Binding Clients.Count,Mode=OneWay}"/>
        <CollectionView 
            Grid.Row="1"
            SelectionMode="Single"
            SelectedItem="{Binding ClienteSeleccionado, Mode=TwoWay}"
            ItemsSource="{Binding Clients,Mode=OneWay}"/>
    </Grid>
</ContentPage>