<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="petshop.Views.HelpSupportPage"
             xmlns:views="clr-namespace:petshop.Views"
             Title="HelpSupportPage">

    <ContentPage.Resources>
        <views:HelpSupportData x:Key="data" visitasPendientes="5" />
    </ContentPage.Resources>
    
    <Grid>
        <Label 
                Text="{Binding Source={StaticResource data},
                Path=visitasPendientes,
                Mode=OneWay}"
               />
        <CollectionView 
            Grid.Row="1"
            ItemsSource="{Binding Source={StaticResource data},
            Path=Clients,
            Mode=OneWay}"/>
    </Grid>
</ContentPage>