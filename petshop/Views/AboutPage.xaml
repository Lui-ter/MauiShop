<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="petshop.Views.AboutPage"
             Title="Acerca de mi Tienda"
             BackgroundColor="#121212"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

            <!-- ENCABEZADO CON BOTÓN DE MENÚ LATERAL -->
            <Grid ColumnDefinitions="Auto,*">
                <Border BackgroundColor="#1E1E1E"
                        Stroke="#333333"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        WidthRequest="42"
                        HeightRequest="42"
                        Padding="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Menu_Tapped" />
                    </Border.GestureRecognizers>
                    <Label Text="☰"
                           FontSize="20"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Margin="15,0,0,0" VerticalOptions="Center">
                    <Label Text="Acerca de mi Tienda"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Conoce más sobre PetShop"
                           FontSize="13"
                           TextColor="#888888" />
                </VerticalStackLayout>
            </Grid>

            <!-- HERO CARD (LOGO Y ESLOGAN) -->
            <Border BackgroundColor="#1E1E1E"
                    Stroke="#333333"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="25">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border BackgroundColor="#2D1F47"
                            Stroke="#A98BFF"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 45"
                            WidthRequest="90"
                            HeightRequest="90"
                            HorizontalOptions="Center">
                        <Label Text="🐾"
                               FontSize="42"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="PetShop Electronics"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Tecnología, computadoras y gadgets al mejor precio del mercado"
                           FontSize="14"
                           TextColor="#AAAAAA"
                           HorizontalTextAlignment="Center" />

                    <Border BackgroundColor="#2A2A2A"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,5"
                            HorizontalOptions="Center">
                        <Label Text="⭐ Calidad Garantizada"
                               FontSize="12"
                               TextColor="#A98BFF"
                               FontAttributes="Bold" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- SECCIÓN: ¿QUIÉNES SOMOS? -->
            <Label Text="¿Quiénes Somos?"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,5,0,0" />

            <Border BackgroundColor="#1E1E1E"
                    Stroke="#333333"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 15"
                    Padding="18">
                <Label Text="En PetShop nos dedicamos a ofrecer lo último en computadoras, dispositivos móviles, equipos de audio y artefactos electrónicos. Nuestro compromiso es brindar productos de la más alta calidad, con precios competitivos y una atención cercana y personalizada para cada uno de nuestros clientes."
                       FontSize="14"
                       TextColor="#CCCCCC"
                       LineHeight="1.3" />
            </Border>

            <!-- SECCIÓN: BENEFICIOS -->
            <Label Text="¿Por qué elegirnos?"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,5,0,0" />

            <!-- BENEFICIO 1 -->
            <Border BackgroundColor="#1E1E1E"
                    Stroke="#333333"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 15"
                    Padding="16">
                <Grid ColumnDefinitions="45,*">
                    <Label Text="🚀" FontSize="24" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Envíos Inmediatos" FontSize="16" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Entregas seguras y rápidas hasta tu puerta" FontSize="12" TextColor="#888888" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- BENEFICIO 2 -->
            <Border BackgroundColor="#1E1E1E"
                    Stroke="#333333"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 15"
                    Padding="16">
                <Grid ColumnDefinitions="45,*">
                    <Label Text="🛡️" FontSize="24" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Garantía Oficial" FontSize="16" FontAttributes="Bold" TextColor="White" />
                        <Label Text="100% de respaldo en todos nuestros productos" FontSize="12" TextColor="#888888" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- BENEFICIO 3 -->
            <Border BackgroundColor="#1E1E1E"
                    Stroke="#333333"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 15"
                    Padding="16">
                <Grid ColumnDefinitions="45,*">
                    <Label Text="💬" FontSize="24" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Soporte y Asesoría 24/7" FontSize="16" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Equipo listo para resolver todas tus dudas" FontSize="12" TextColor="#888888" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- SECCIÓN: CONTACTO -->
            <Label Text="Contacto y Ubicación"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,5,0,0" />

            <Border BackgroundColor="#1E1E1E"
                    Stroke="#333333"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 15"
                    Padding="18">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="30,*">
                        <Label Text="📍" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Av. Tecnológica #520, Sector Comercial" FontSize="14" TextColor="#CCCCCC" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="30,*">
                        <Label Text="📞" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="+51 987 654 321" FontSize="14" TextColor="#CCCCCC" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="30,*">
                        <Label Text="✉️" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="contacto@petshop.com" FontSize="14" TextColor="#CCCCCC" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="30,*">
                        <Label Text="⏰" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Lunes a Sábado: 9:00 AM - 8:00 PM" FontSize="14" TextColor="#CCCCCC" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- INFORMACIÓN DE VERSIÓN -->
            <Border BackgroundColor="#1E1E1E"
                    Stroke="#333333"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 15"
                    Padding="16">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="PetShop App v1.0.0" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                    <Label Text="Desarrollado con .NET MAUI &amp; C#" FontSize="12" TextColor="#777777" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- BOTÓN PARA IR A LA TIENDA -->
            <Button Text="🏠 Ir a la Tienda (Home)"
                    BackgroundColor="#A98BFF"
                    TextColor="#121212"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50"
                    Margin="0,5,0,20"
                    Clicked="IrAHome_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

