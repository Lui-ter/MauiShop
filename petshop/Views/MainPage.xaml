<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="petshop.Views.MainPage"
    BackgroundColor="#121212"
    Title="Home">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="20">

            <!-- ENCABEZADO -->

            <VerticalStackLayout Spacing="5">

                <Label
                    Text="🐾 PetShop"
                    FontSize="16"
                    TextColor="#AAAAAA" />

                <Label
                    Text="Computadoras"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Label
                    Text="Productos disponibles"
                    FontSize="15"
                    TextColor="#888888" />

            </VerticalStackLayout>


            <!-- PRODUCTOS -->

            <CollectionView
                x:Name="Listaproductos"
                SelectionMode="None">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            BackgroundColor="#1E1E1E"
                            Stroke="#333333"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 15"
                            Padding="18"
                            Margin="0,5">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="15"
                                RowSpacing="5">

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="{Binding Nombre}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="{Binding Descripcion}"
                                    FontSize="13"
                                    TextColor="#999999" />

                                <Label
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    Text="{Binding Precio, StringFormat='${0:N0}'}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="#A98BFF"
                                    VerticalOptions="Center" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>


            <!-- RESUMEN -->

            <Label
                Text="Resumen"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="White"
                Margin="0,10,0,0" />


            <!-- CLIENTES -->

            <Border
                BackgroundColor="#1E1E1E"
                Stroke="#333333"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 15"
                Padding="18">

                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Text="👥 Clientes"
                        FontSize="16"
                        TextColor="#BBBBBB"
                        VerticalOptions="Center" />

                    <Label
                        x:Name="client"
                        Grid.Column="1"
                        Text="0"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White" />

                </Grid>

            </Border>


            <!-- PRODUCTOS -->

            <Border
                BackgroundColor="#1E1E1E"
                Stroke="#333333"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 15"
                Padding="18">

                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Text="📦 Productos"
                        FontSize="16"
                        TextColor="#BBBBBB"
                        VerticalOptions="Center" />

                    <Label
                        x:Name="product"
                        Grid.Column="1"
                        Text="0"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White" />

                </Grid>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>