<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="petshop.Views.HelpSupportDetailPage"
             xmlns:views="clr-namespace:petshop.Views"
             Title="HelpSupportDetailPage">
    
    <ContentPage.BindingContext>
        <views:HelpSupportDetailData/>
    </ContentPage.BindingContext>

    <Grid RowDefinitions="2*,Auto,*" ColumnDefinitions="*,*">
        <VerticalStackLayout Grid.Row="0" Grid.Column="0">
            <CollectionView
                ItemsSource="{Binding Products}"
                SelectedItem="{Binding ProductoSeleccionado, Mode=TwoWay}"
                ItemTemplate="{StaticResource ProductDataTemplate}"
                HeightRequest="300"
                SelectionMode="Single"
                />
            <Picker ItemsSource="{Binding Products}"
                SelectedItem="{Binding ProductoSeleccionado, Mode=TwoWay}"
            />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="0" Grid.Column="1">
            <Label Text="Nombre" />
            <Label Text="{Binding ProductoSeleccionado.Nombre}"/>
            <Label Text="Descripcion"/>
            <Label Text="{Binding ProductoSeleccionado.Descripcion}"/>
            <Label Text="Precio"/>
            <Label Text="{Binding ProductoSeleccionado.Precio, StringFormat='{0:C}'}"/>
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="1"
                               Grid.Column="0"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Spacing="12">
            <Button Text="-"
                    WidthRequest="52"
                    HeightRequest="52"
                    FontSize="24"
                    Padding="0"
                    Command="{Binding DecreaseQuantityCommand}" />
            <Label Text="{Binding Cantidad}"
                   FontSize="20"
                   FontAttributes="Bold"
                   MinimumWidthRequest="36"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />
            <Button Text="+"
                    WidthRequest="52"
                    HeightRequest="52"
                    FontSize="24"
                    Padding="0"
                    Command="{Binding IncreaseQuantityCommand}" />
        </HorizontalStackLayout>

        <Button Grid.Row="1"
                Grid.Column="1"
                Text="Agregar"
                Command="{Binding AddCommand}" />

        <CollectionView Grid.Row="2"
                        Grid.ColumnSpan="2"
                        ItemsSource="{Binding Compras}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No hay compras registradas." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnDefinitions="*,*,*">
                        <Label Text="{Binding ClientId, StringFormat='Cliente: {0}'}" />
                        <Label Grid.Column="1"
                               Text="{Binding ProductId, StringFormat='Producto: {0}'}" />
                        <Label Grid.Column="2"
                               Text="{Binding Cantidad, StringFormat='Cantidad: {0}'}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>