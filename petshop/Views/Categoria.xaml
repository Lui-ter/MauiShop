<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:handlers="clr-namespace:petshop.Handler"
             x:Class="petshop.Views.Categoria"
             Title="Categoria">

    <Shell.SearchHandler>
        <handlers:CategoriaBusquedaHandler
            Placeholder="Buscar categorías..."
            ShowsResults="True" />
    </Shell.SearchHandler>

    <VerticalStackLayout x:Name="container">
        <Label
            Text="Categorias"
            FontSize="30"
            FontAttributes="Bold"
            TextColor="White" />

        <Label
            Text="Categorias disponibles"
            FontSize="15"
            TextColor="#888888" />
    </VerticalStackLayout>
</ContentPage>
