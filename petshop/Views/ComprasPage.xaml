<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="petshop.Views.ComprasPage"
             Title="Compras registradas">

    <Grid Padding="12" RowDefinitions="Auto,*">
        <Label Text="Compras guardadas en SQLite"
               FontSize="20"
               FontAttributes="Bold"
               Margin="8" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Compras}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No hay compras registradas."
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12"
                            Margin="4"
                            Stroke="#D0D0D0"
                            StrokeThickness="1">
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto,Auto">
                            <Label Text="{Binding Producto}"
                                   FontAttributes="Bold"
                                   FontSize="16" />
                            <Label Grid.Column="1"
                                   Text="{Binding Total, StringFormat='{0:C}'}"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="1"
                                   Text="{Binding Id, StringFormat='Compra #{0}'}" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Cliente, StringFormat='Cliente: {0}'}" />
                            <Label Grid.Row="2"
                                   Text="{Binding Cantidad, StringFormat='Cantidad: {0}'}" />
                            <Label Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding PrecioUnitario, StringFormat='Precio unitario: {0:C}'}"
                                   HorizontalTextAlignment="End" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
